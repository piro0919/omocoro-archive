    },
    "react-toggle": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
    },
    "stylelint-css-modules-no-global-scoped-selector": {
      "stylelint": "$stylelint"
    },
    "stylelint-no-unused-selectors": {
      "stylelint": "$stylelint"
    },
    "usehooks-ts": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
    }
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "depcheck": "depcheck",
    "dev": "next dev",
    "dev:prod": "cross-env NODE_ENV=production next dev",
    "find:unused": "next-unused",
    "knip": "knip",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:style": "stylelint --fix '**/*.css'",
    "migrate": "npx prisma migrate deploy",
    "migrate:create": "dotenv -e .env.local -- npx prisma migrate dev",
    "migrate:dev": "dotenv -e .env.development.local -- npm run migrate",
    "migrate:prod": "dotenv -e .env.local -- npm run migrate",
    "prettier": "prettier --write .",
    "seed": "cross-env NODE_ENV=development tsx prisma/seed.ts",
    "seed:local": "cross-env NODE_ENV=development tsx prisma/seed-local.ts",
    "start": "next start",
    "studio": "npx prisma studio",
    "studio:dev": "dotenv -e .env.development.local -- npm run studio",
    "studio:prod": "dotenv -e .env.local -- npm run studio",
    "type-check": "tsc --noemit",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "lighthouse": "npm run build && lhci autorun"
  },
  "version": "0.1.0"
}
